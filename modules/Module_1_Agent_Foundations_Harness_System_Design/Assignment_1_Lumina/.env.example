# LUMINA — copy to .env and fill in. .env is git-ignored; never commit real keys.
# Both services read this file from the repo root.

# ---------- MongoDB Atlas (documents, memory, cache, jobs, vectors, GridFS) ----------
# Atlas free tier (M0) is enough for two weeks. A local mongod has no Vector Search:
# see VECTOR_BACKEND below.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lumina

# atlas-vector-search (default) | mongo-cosine-scan (local mongod fallback, /health must say so)
VECTOR_BACKEND=atlas-vector-search

# ---------- LLM ----------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# The quick gear's model; unset means LLM_MODEL. Each model is priced at its own published
# rate (backend/agent/src/pricing.ts), so a cheaper quick model shows up in done.costUsd.
# QUICK_LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# ---------- Search (swappable with no code change) ----------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARCH_CACHE_TTL_SECONDS=21600
# Tavily search_depth: advanced | basic | fast | ultra-fast. basic is the default.
TAVILY_SEARCH_DEPTH=basic
# How long an idle connection to Tavily is kept for the next call, in ms.
TAVILY_KEEPALIVE_MS=60000

# ---------- Quick gear: the path to the first token ----------
# Results of the first search read before the model is called, and how long each may take.
QUICK_PREFETCH_PAGES=3
PREFETCH_TIMEOUT_MS=1500
# Once this many pages are in, the rest get QUICK_PREFETCH_GRACE_MS more, then are stopped.
QUICK_PREFETCH_ENOUGH=2
QUICK_PREFETCH_GRACE_MS=200
# Text is held until it cites a source or runs this many characters, so a preamble before a
# tool call never reaches the user as the answer.
QUICK_COMMIT_AFTER_CHARS=40

# ---------- OpenAI (embeddings; needed even when the LLM is Anthropic) ----------
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Ingestion (the jobs worker: npm run worker, started by npm run dev) ----------
# Chunk size and overlap in characters, about four to a token.
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=200
EMBED_BATCH_SIZE=64
# A running job with no heartbeat this long goes back to pending; /health goes degraded
# when the worker's own heartbeat is this old. 3 attempts, then the document is failed.
JOB_STALE_MS=120000
JOB_MAX_ATTEMPTS=3
WORKER_HEARTBEAT_MS=10000
PROBE_TIMEOUT_MS=90000

# ---------- Document search (hybrid: vector + BM25, fused with reciprocal rank fusion) ----------
# Chunks search_documents returns. recall@5 is measured on these.
RAG_TOP_K=5
# RRF damping constant: score = sum of 1 / (k + rank). 60 is the original paper's value.
RAG_RRF_K=60
# Hits each retriever returns before fusion. Over-fetched so chunks of documents that are
# not yet indexed can be dropped and RAG_TOP_K still filled.
RAG_CANDIDATES=20

# ---------- Deep search: the expensive gear, so the gates live here ----------
# Sub-questions a plan may hold. Fewer than 3 is a quick search with extra steps.
DEEP_SUB_QUESTIONS_MIN=3
DEEP_SUB_QUESTIONS_MAX=6
# Deep searches per X-User-Id per day. Over cap -> 429 {error, resetsAt}, enforced in the
# agent service. A cap you document but do not enforce is not a cap.
DEEP_DAILY_CAP=5
# Sub-questions researched at once, and how long one page read on a deep run may take.
DEEP_CONCURRENCY=3
DEEP_FETCH_TIMEOUT_MS=6000

# ---------- Loop caps (the hard caps from AGENTS.md; do not raise to pass a gate) ----------
MAX_TOOL_CALLS=8
MAX_WALL_CLOCK_SEC=90
# Deep gets a wider envelope because it is doing more, not because it is allowed to sprawl.
MAX_TOOL_CALLS_DEEP=24
MAX_WALL_CLOCK_SEC_DEEP=240

# ---------- Ports & wiring ----------
PORT_GATEWAY=8787
PORT_AGENT=8000
AGENT_URL=http://localhost:8000
# Comma-separated origins the gateway accepts. Add your Vercel URL before you deploy.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# ---------- Web (Vite; only VITE_* reaches the browser — never put a key here) ----------
VITE_API_URL=http://localhost:8787
